# ===========================================
# Homeschool LMS - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Never commit the .env file to version control.

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
# Your Supabase project URL (e.g., https://xxxx.supabase.co)
SUPABASE_URL=http://localhost:54321

# Supabase anonymous (public) key - safe to use in frontend
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - NEVER expose this in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT secret - used for verifying tokens in the backend
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -------------------------------------------
# Redis Configuration
# -------------------------------------------
# Redis connection URL for caching
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# Application URLs
# -------------------------------------------
# Frontend URL (used for CORS, redirects, etc.)
FRONTEND_URL=http://localhost:5173

# Backend URL and port
BACKEND_URL=http://localhost:3000
BACKEND_PORT=3000

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development
